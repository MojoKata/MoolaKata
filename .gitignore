# Screenshots: CI makes the app's on every run (S12.7.5); web/dev.sh make-screenshots or
# download-screenshots puts the guides' in web/ui/guides/shots/ here.
shots/
__pycache__/
web/.tools/
web/.dev/
web/.dev-*/
.venv/
web/ui/vendor/*/
.pytest_cache/
.ruff_cache/

# A review's withheld claims (docs/REVIEW.md §2)
docs/reviews/*/withheld.md

# The mockup generated from the app (requirements S12.9): built by CI and published, never
# committed (web/dev.sh mockup builds it here to open from disk).
docs/mockups/MoolaKata-app.html
docs/mockups/MoolaKata-app.part*.json
