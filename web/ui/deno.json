{
  "unstable": [
    "sloppy-imports"
  ],
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noImplicitAny": false,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "preact": "./vendor/preact/src/index.d.ts",
    "preact/hooks": "./vendor/preact/hooks/src/index.d.ts",
    "htm": "./vendor/htm/dist/htm.d.ts",
    "@preact/signals-core": "./vendor/signals-core/dist/signals-core.d.ts",
    "@preact/signals": "./vendor/signals/dist/signals.d.ts",
    "preact-iso": "./vendor/preact-iso/src/index.d.ts",
    "@mk/preact-iso": "./vendor/preact-iso/src/index.d.ts",
    "echarts": "./charts/echarts.d.ts",
    "prosemirror-model": "./vendor/prosemirror-model/dist/index.d.ts",
    "prosemirror-state": "./vendor/prosemirror-state/dist/index.d.ts",
    "prosemirror-view": "./vendor/prosemirror-view/dist/index.d.ts",
    "prosemirror-transform": "./vendor/prosemirror-transform/dist/index.d.ts",
    "prosemirror-commands": "./vendor/prosemirror-commands/dist/index.d.ts",
    "prosemirror-keymap": "./vendor/prosemirror-keymap/dist/index.d.ts",
    "prosemirror-history": "./vendor/prosemirror-history/dist/index.d.ts",
    "prosemirror-inputrules": "./vendor/prosemirror-inputrules/dist/index.d.ts",
    "prosemirror-schema-list": "./vendor/prosemirror-schema-list/dist/index.d.ts",
    "orderedmap": "./vendor/orderedmap/dist/index.d.ts",
    "rope-sequence": "./vendor/rope-sequence/dist/index.d.ts",
    "w3c-keyname": "./vendor/w3c-keyname/index.d.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": true,
    "include": [
      "app/",
      "api/",
      "store/",
      "screens/",
      "components/",
      "charts/",
      "account-types/",
      "kit/",
      "mockup/",
      "tests/"
    ],
    "exclude": [
      "api/openapi.json",
      "api/fields.js"
    ]
  },
  "lint": {
    "include": [
      "app/",
      "api/",
      "store/",
      "screens/",
      "components/",
      "charts/",
      "account-types/",
      "kit/",
      "mockup/",
      "tests/"
    ],
    "rules": {
      "exclude": [
        "no-window"
      ]
    }
  }
}
