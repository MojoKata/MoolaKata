{
  "limits": { "chars": 20000, "bytes": 262144, "listDepth": 3, "linkLength": 2000 },
  "nodes": {
    "doc": { "content": "block+" },
    "paragraph": { "group": "block", "content": "inline*", "marks": "_" },
    "heading": {
      "group": "block",
      "content": "inline*",
      "marks": "_",
      "attrs": { "level": [1, 2, 3] }
    },
    "pre": { "group": "block", "content": "text*", "marks": "" },
    "quote": { "group": "block", "content": "(paragraph | bullets | numbers)+" },
    "bullets": { "group": "block", "content": "item+" },
    "numbers": { "group": "block", "content": "item+" },
    "item": { "content": "paragraph (bullets | numbers)*" },
    "text": { "group": "inline" },
    "break": { "group": "inline", "inline": true }
  },
  "marks": {
    "bold": {},
    "italic": {},
    "underline": {},
    "strike": {},
    "highlight": {},
    "mono": {},
    "link": { "attrs": ["href", "page"] }
  }
}
