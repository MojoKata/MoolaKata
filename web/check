#!/usr/bin/env bash
# Every check, as CI runs it (requirements S17.5). No Node.js: pytest, ruff, Deno and
# Playwright for Python. Run `web/dev.sh setup` once first.
set -uo pipefail

WEB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(dirname "$WEB")"
SERVER="$WEB/server"
unset VIRTUAL_ENV
failed=()

step() {
  local name="$1"
  shift
  printf '\n== %s\n' "$name"
  if "$@"; then
    printf '   ok\n'
  else
    printf '   FAILED: %s\n' "$name"
    failed+=("$name")
  fi
}

py() { (cd "$SERVER" && uv run --frozen --quiet "$@"); }
deno() { "$WEB/dev.sh" deno "$@"; }

step "uv.lock matches pyproject.toml" bash -c "cd '$SERVER' && uv lock --check --quiet"
step "every dependency has amd64 and arm64 wheels" py python -m moolakata.dev.wheels
step "the dependency register is audited (S17.2.1)" py python -m moolakata.dev.audit check
step "the base image's age (a warning only)" py python -m moolakata.dev.base check
step "vendored browser libraries" python3 "$WEB/ui/vendor/vendor.py" extract
step "ruff" py ruff check src tests ../ui/mockup ../../docs/mockups ../../docs/reviews ../../connector
step "ruff format" py ruff format --check --quiet src tests ../ui/mockup ../../docs/mockups ../../docs/reviews ../../connector
step "the requirements' ids, tables and sizes" python3 "$ROOT/docs/reviews/check_docs.py" --quiet
js_dirs=()
for d in app api store screens components charts account-types mockup tests; do
  [[ -d "$WEB/ui/$d" ]] && js_dirs+=("$WEB/ui/$d/")
done
step "deno check" deno check --quiet --config "$WEB/ui/deno.json" "${js_dirs[@]}"
step "deno lint" deno lint --quiet --config "$WEB/ui/deno.json"
step "deno fmt" deno fmt --check --quiet --config "$WEB/ui/deno.json"
step "OpenAPI and typedef drift" py python -m moolakata.contract check
if [[ -f "$WEB/ui/mockup/build.py" ]]; then
  step "generated mockup drift" py python "$WEB/ui/mockup/build.py" --check
fi
step "pytest (server, schema, browser)" py pytest
step "pytest (the connector)" py pytest "$ROOT/connector/tests"
step "hand-written mockup" py python "$ROOT/docs/mockups/check.py" "$WEB/.dev/check-shots"

if ((${#failed[@]})); then
  printf '\nFAILED: %s\n' "${failed[*]}"
  exit 1
fi
printf '\nall checks passed\n'
